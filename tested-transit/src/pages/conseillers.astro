---
import { vendeurs } from '../../data/vendeurs';

// Dédupliquer par slug
const vendeursSansDoublons = vendeurs.filter(
  (v, index, self) => index === self.findIndex((t) => t.slug === v.slug)
);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Nos conseillers — Ecocuisine</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=Nunito+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>

    <header class="site-header">
      <div class="header-inner">
        <a href="https://ecocuisine.fr" class="brand">
          <img src="/images/logo.png" alt="Ecocuisine" class="brand-logo" />
        </a>
      </div>
    </header>

    <section class="hero">
      <div class="hero-bg"></div>
      <div class="hero-content">
        <p class="hero-label">Nos équipes</p>
        <h1 class="hero-titre">Choisissez votre<br/><em>conseiller</em></h1>
        <p class="hero-sub">Scannez le QR code ou sélectionnez votre conseiller ci-dessous pour accéder à sa fiche personnalisée.</p>
      </div>
    </section>

    <main>
      <div class="container">

        <div class="zone-group">
          <h2 class="zone-title">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            Andelnans
          </h2>
          <div class="grid">
            {vendeursSansDoublons.filter(v => v.zone === 'Andelnans').map((v) => (
              <a href={`/vendeurs/${v.slug}`} class="card">
                <div class="card-img-wrap">
                  <img src={v.photo} alt={`${v.prenom} ${v.nom}`} class="card-img" />
                  <div class="card-overlay">
                    <span class="card-cta-btn">Voir la fiche →</span>
                  </div>
                </div>
                <div class="card-body">
                  <p class="card-name">{v.prenom} <span>{v.nom}</span></p>
                  <p class="card-titre">{v.titre}</p>
                  <div class="card-meta">
                    <span class="card-anciennete">{v.anciennete} ans d'expérience</span>
                    {v.specialites.map(s => <span class="card-tag">{s}</span>)}
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>

        <div class="zone-group">
          <h2 class="zone-title">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            Taillecourt
          </h2>
          <div class="grid">
            {vendeursSansDoublons.filter(v => v.zone === 'Taillecourt').map((v) => (
              <a href={`/vendeurs/${v.slug}`} class="card">
                <div class="card-img-wrap">
                  <img src={v.photo} alt={`${v.prenom} ${v.nom}`} class="card-img" />
                  <div class="card-overlay">
                    <span class="card-cta-btn">Voir la fiche →</span>
                  </div>
                </div>
                <div class="card-body">
                  <p class="card-name">{v.prenom} <span>{v.nom}</span></p>
                  <p class="card-titre">{v.titre}</p>
                  <div class="card-meta">
                    <span class="card-anciennete">{v.anciennete} ans d'expérience</span>
                    {v.specialites.map(s => <span class="card-tag">{s}</span>)}
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>

      </div>
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>© {new Date().getFullYear()} Ecocuisine — Belfort & Montbéliard</p>
      </div>
    </footer>

  </body>
</html>

<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --cream: #FAF7F2;
    --warm-white: #FFFEF9;
    --bark: #1A1A1A;
    --bark-light: #3D3D3D;
    --orange: #F07D00;
    --orange-light: #FFB05A;
    --orange-dark: #C96500;
    --stone: #8E8078;
    --stone-light: #D4CCC4;
    --sage-light: #B8D4BA;
    --font-display: 'Nunito', system-ui, sans-serif;
    --font-body: 'Nunito Sans', system-ui, sans-serif;
  }

  html { scroll-behavior: smooth; }

  body {
    font-family: var(--font-body);
    background: var(--cream);
    color: var(--bark);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  /* ---- HEADER ---- */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(26, 26, 26, 0.95);
    backdrop-filter: blur(12px);
  }
  .header-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 16px 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .brand {
    text-decoration: none;
    font-size: 24px;
    font-weight: 900;
    letter-spacing: -0.03em;
    font-family: var(--font-display);
  }
  .brand-eco { color: var(--orange); }
  .brand-cuisine { color: white; }

  /* ---- HERO ---- */
  .hero {
    position: relative;
    background: var(--bark);
    overflow: hidden;
    padding: 80px 24px;
    text-align: center;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 60% 50%, rgba(240,125,0,0.18) 0%, transparent 65%),
                radial-gradient(ellipse at 20% 80%, rgba(122,158,126,0.08) 0%, transparent 50%);
  }
  .hero-content {
    position: relative;
    max-width: 600px;
    margin: 0 auto;
  }
  .hero-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--orange-light);
    font-weight: 800;
    margin-bottom: 16px;
    font-family: var(--font-display);
  }
  .hero-titre {
    font-family: var(--font-display);
    font-size: clamp(36px, 6vw, 64px);
    font-weight: 900;
    color: white;
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin-bottom: 20px;
  }
  .hero-titre em {
    font-style: italic;
    color: var(--orange-light);
  }
  .hero-sub {
    font-size: 16px;
    color: rgba(255,255,255,0.55);
    font-weight: 300;
    max-width: 480px;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* ---- MAIN ---- */
  main { padding: 64px 0 80px; }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ---- ZONES ---- */
  .zone-group { margin-bottom: 64px; }
  .zone-group:last-child { margin-bottom: 0; }

  .zone-title {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--stone);
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 28px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--stone-light);
  }
  .zone-title svg { color: var(--orange); flex-shrink: 0; }

  /* ---- GRID ---- */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 24px;
  }

  /* ---- CARD ---- */
  .card {
    background: white;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--stone-light);
    text-decoration: none;
    color: inherit;
    display: block;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 48px rgba(61,43,26,0.12);
  }

  .card-img-wrap {
    position: relative;
    overflow: hidden;
  }
  .card-img {
    width: 100%;
    height: 240px;
    object-fit: cover;
    display: block;
    transition: transform 0.4s;
  }
  .card:hover .card-img { transform: scale(1.04); }

  .card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(240,125,0,0.75) 0%, transparent 60%);
    display: flex;
    align-items: flex-end;
    padding: 20px;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .card:hover .card-overlay { opacity: 1; }

  .card-cta-btn {
    color: white;
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .card-body { padding: 20px 24px 24px; }

  .card-name {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 900;
    color: var(--bark);
    margin-bottom: 4px;
    letter-spacing: -0.01em;
  }
  .card-name span {
    font-style: italic;
    color: var(--orange);
  }

  .card-titre {
    font-size: 13px;
    color: var(--stone);
    font-weight: 400;
    margin-bottom: 14px;
  }

  .card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
  }

  .card-anciennete {
    font-size: 12px;
    font-weight: 700;
    color: var(--orange-dark);
    background: rgba(240,125,0,0.08);
    padding: 4px 10px;
    border-radius: 100px;
    font-family: var(--font-display);
  }

  .card-tag {
    font-size: 11px;
    color: var(--stone);
    background: var(--cream);
    border: 1px solid var(--stone-light);
    padding: 3px 9px;
    border-radius: 100px;
    font-weight: 500;
  }

  /* ---- FOOTER ---- */
  .site-footer {
    background: #111;
    padding: 24px 0;
    text-align: center;
  }
  .site-footer p {
    font-size: 13px;
    color: var(--stone);
    font-weight: 400;
  }

  /* ---- RESPONSIVE ---- */
  @media (max-width: 600px) {
    .hero { padding: 56px 24px; }
    main { padding: 40px 0 56px; }
    .grid { grid-template-columns: 1fr 1fr; gap: 14px; }
    .card-img { height: 160px; }
    .card-body { padding: 14px 16px 18px; }
    .card-name { font-size: 16px; }
    .zone-group { margin-bottom: 40px; }
  }

  @media (max-width: 400px) {
    .grid { grid-template-columns: 1fr; }
  }
  .brand-logo {
  height: 36px;
  width: auto;
  display: block;
}
</style>